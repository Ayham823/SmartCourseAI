# Copy to .env and replace placeholders locally. Never commit .env.
# Preserve credentials matching an existing PostgreSQL volume.
POSTGRES_DB=smartcourse
POSTGRES_USER=smartcourse
POSTGRES_PASSWORD=replace_with_local_database_password
DATABASE_URL=postgresql://smartcourse:replace_with_local_database_password@localhost:5432/smartcourse

# Use your own active key and a model ID available to your Anthropic account.
# These placeholders intentionally cannot authenticate or select a model.
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
ANTHROPIC_MODEL=replace_with_an_accessible_model_id

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
MAX_MESSAGE_LENGTH=4000
MEMORY_MESSAGES=20

# Bounded provider settings; SDK retries transient failures with backoff.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1024

# Minimum cosine similarity for a document chunk to count as evidence.
RAG_MIN_SIMILARITY=0.25

# Tests default to mocks. Enable opt-in checks explicitly; live tests cost API usage.
SMARTCOURSE_INTEGRATION_TESTS=0
SMARTCOURSE_LIVE_TESTS=0
